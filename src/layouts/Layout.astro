---
import '../styles/global.scss';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>DroidUtility | Android Utility Suite</title>
  <meta name="description" content="A powerful, non-root Android utility suite for debloating, shell commands, and system tweaks." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>
<body>
  <slot />
</body>
</html>

<style is:global>
  /* Global Background Effect */
  body {
    background-color: #0d0d0d;
    background-image: radial-gradient(circle at 15% 50%, rgba(144, 202, 249, 0.08), transparent 25%),
                      radial-gradient(circle at 85% 30%, rgba(128, 203, 196, 0.08), transparent 25%);
    background-attachment: fixed;
  }
</style>
