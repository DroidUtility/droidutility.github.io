---
import Layout from '../../layouts/Layout.astro';
---

<Layout>
  <div class="page-wrapper">
    <header class="header">
      <a href="/" class="logo">DROIDUTILITY</a>
      <nav class="nav">
        <a href="/features/features" class="active">Features</a>
        <a href="https://github.com/DroidUtility/DroidUtility" target="_blank"><i class="fab fa-github"></i> GitHub</a>
        <a href="https://github.com/DroidUtility/DroidUtility/releases" class="btn-download"><i class="fas fa-download"></i> Download</a>
      </nav>
    </header>

    <main class="hero">
      <h1>Features.</h1>
      <p class="subtitle">Everything you need to take control of your Android device.</p>
      
      <div class="feature-list">
        <div class="feature-item">
          <i class="fas fa-broom feature-icon"></i>
          <div>
            <h2>Debloat Manager</h2>
            <p>Powered by the Universal Android Debloater list. Remove system apps safely with clear safety ratings.</p>
          </div>
        </div>
        
        <div class="feature-item">
          <i class="fas fa-terminal feature-icon"></i>
          <div>
            <h2>True Terminal</h2>
            <p>A fully functional terminal environment running via Shizuku. Powered by libghostty-vt.</p>
          </div>
        </div>
        
        <div class="feature-item">
          <i class="fas fa-sliders-h feature-icon"></i>
          <div>
            <h2>System Tweaks</h2>
            <p>Apply performance and battery optimizations directly from the app without root.</p>
          </div>
        </div>
      </div>
    </main>
  </div>
</Layout>

<style>
  .page-wrapper { max-width: 1100px; margin: 0 auto; border-left: 1px solid #d0d0d0; border-right: 1px solid #d0d0d0; min-height: 100vh; }
  .header { display: flex; justify-content: space-between; align-items: center; padding: 24px 40px; border-bottom: 1px solid #d0d0d0; }
  .logo { font-size: 1.4rem; font-weight: 800; color: #0a0a0a; text-decoration: none; letter-spacing: -1px; }
  .nav { display: flex; gap: 24px; align-items: center; font-size: 0.85rem; font-weight: 600; }
  .nav a { color: #666; text-decoration: none; display: flex; align-items: center; gap: 6px; }
  .nav a:hover, .nav a.active { color: #0a0a0a; }
  .btn-download { background: #0a0a0a; color: #fff !important; padding: 8px 16px; display: flex; align-items: center; gap: 6px; }
  
  .hero { padding: 80px 40px; }
  .hero h1 { font-size: 4rem; font-weight: 600; letter-spacing: -2px; margin-bottom: 16px; }
  .subtitle { font-size: 1rem; color: #555; margin-bottom: 60px; }
  
  .feature-list { display: flex; flex-direction: column; gap: 40px; }
  .feature-item { display: flex; gap: 24px; border-top: 1px solid #d0d0d0; padding-top: 24px; }
  .feature-icon { font-size: 1.5rem; color: #0a0a0a; margin-top: 4px; }
  .feature-item h2 { font-size: 1.2rem; font-weight: 800; margin-bottom: 8px; }
  .feature-item p { color: #555; line-height: 1.6; max-width: 600px; }
</style>
