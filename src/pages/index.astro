---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="blank-screen">
    <header class="minimal-header">
      <span class="logo">DROIDUTILITY_</span>
    </header>
  </div>
</Layout>

<style>
  .blank-screen {
    min-height: 50vh;
    display: flex;
    flex-direction: column;
  }

  .minimal-header {
    padding: 24px 32px;
    border-bottom: 1px solid #d0d0d0;
  }

  .logo {
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: -0.5px;
  }
</style>
