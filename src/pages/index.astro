---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="page-wrapper">
    
    <!-- Updated Header -->
    <header class="header">
      <a href="/" class="logo">DROIDUTILITY</a>
      
      <nav class="nav">
        <a href="/docs">Docs</a>
        <a href="/features/features">Features</a>
        <a href="https://github.com/DroidUtility/DroidUtility/releases" target="_blank">Versions</a>
        <a href="https://github.com/DroidUtility/DroidUtility" target="_blank"><i class="fab fa-github"></i> GitHub</a>
        
        <!-- Dropdown Menu -->
        <div class="dropdown">
          <span class="dropdown-trigger">More <i class="fas fa-chevron-down" style="font-size: 0.7rem;"></i></span>
          <div class="dropdown-content">
            <a href="https://github.com/DroidUtility/DroidUtility/issues" target="_blank">Report Bug</a>
            <a href="https://github.com/DroidUtility/DroidUtility/blob/main/LICENSE" target="_blank">License</a>
            <a href="https://droidutility.github.io/about">About</a>
          </div>
        </div>

        <a href="https://github.com/DroidUtility/DroidUtility/releases" class="btn-download"><i class="fas fa-download"></i> Download</a>
      </nav>
    </header>

    <!-- Hero Section -->
    <main class="hero">
      <h1>The non-root<br>Android utility suite</h1>
      <p class="subtitle">
        Debloat system apps, run interactive terminal commands,<br>
        and optimize your device using Shizuku.
      </p>

      <!-- Clean Action Row -->
      <div class="action-row">
        <a href="https://github.com/DroidUtility/DroidUtility/releases" class="action-card">
          <i class="fab fa-android"></i>
          <span>Download APK</span>
        </a>
        <a href="https://github.com/DroidUtility/DroidUtility" target="_blank" class="action-card">
          <i class="fab fa-github"></i>
          <span>Source Code</span>
        </a>
        <a href="/features/features" class="action-card">
          <i class="fas fa-book"></i>
          <span>Read Docs</span>
        </a>
      </div>
    </main>

    <!-- Icon-Based Features Grid -->
    <section class="features-grid">
      <div class="feature-box">
        <i class="fas fa-broom"></i>
        <h3>Debloat</h3>
        <p>Remove system apps safely using the UAD list. No root required.</p>
      </div>
      <div class="feature-box">
        <i class="fas fa-terminal"></i>
        <h3>Terminal</h3>
        <p>A native terminal engine with full ANSI rendering and interactive prompts.</p>
      </div>
      <div class="feature-box">
        <i class="fas fa-sliders-h"></i>
        <h3>Tweaks</h3>
        <p>Apply system-level performance and battery optimizations with one tap.</p>
      </div>
    </section>

    <!-- Large Visual Area -->
    <section class="visual-area">
      <div class="visual-placeholder">
        <i class="fab fa-android" style="font-size: 4rem; margin-bottom: 16px; color: #333;"></i>
        <h2>DROIDUTILITY</h2>
        <p>[ App Screenshots Coming Soon ]</p>
      </div>
    </section>

  </div>
</Layout>

<style>
  .page-wrapper {
    max-width: 1100px; margin: 0 auto;
    border-left: 1px solid #d0d0d0; border-right: 1px solid #d0d0d0;
    min-height: 100vh; display: flex; flex-direction: column;
  }

  /* Header */
  .header { display: flex; justify-content: space-between; align-items: center; padding: 24px 40px; border-bottom: 1px solid #d0d0d0; }
  .logo { font-size: 1.4rem; font-weight: 800; letter-spacing: -1px; color: #0a0a0a; text-decoration: none; }
  .nav { display: flex; align-items: center; gap: 24px; font-size: 0.85rem; font-weight: 600; }
  .nav a { color: #666; text-decoration: none; display: flex; align-items: center; gap: 6px; transition: color 0.2s; }
  .nav a:hover { color: #0a0a0a; }
  .btn-download { background: #0a0a0a; color: #f2f2f2 !important; padding: 8px 16px; border: 1px solid #0a0a0a; display: flex; align-items: center; gap: 6px; }
  .btn-download:hover { background: #333; }

  /* Hero */
  .hero { padding: 80px 40px; border-bottom: 1px solid #d0d0d0; }
  .hero h1 { font-size: clamp(2.5rem, 5vw, 3.5rem); font-weight: 600; line-height: 1.1; letter-spacing: -2px; margin-bottom: 24px; }
  .subtitle { font-size: 1rem; color: #555; line-height: 1.6; margin-bottom: 40px; max-width: 600px; }

  /* Action Row (Replaces terminal block) */
  .action-row { display: flex; gap: 16px; flex-wrap: wrap; }
  .action-card { 
    display: flex; align-items: center; gap: 12px;
    padding: 16px 24px; border: 1px solid #d0d0d0;
    text-decoration: none; color: #0a0a0a; font-weight: 600; font-size: 0.9rem;
    transition: all 0.2s; background: transparent;
  }
  .action-card i { font-size: 1.2rem; }
  .action-card:hover { background: #0a0a0a; color: #f2f2f2; }

  /* Features Grid */
  .features-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; border-bottom: 1px solid #d0d0d0; }
  .feature-box { padding: 40px; border-right: 1px solid #d0d0d0; }
  .feature-box:last-child { border-right: none; }
  .feature-box i { font-size: 1.5rem; margin-bottom: 16px; display: block; color: #0a0a0a; }
  .feature-box h3 { font-size: 1rem; font-weight: 800; margin-bottom: 12px; }
  .feature-box p { font-size: 0.85rem; color: #555; line-height: 1.6; }

  /* Visual Area */
  .visual-area { flex-grow: 1; background: #0a0a0a; padding: 60px 40px; display: flex; align-items: center; justify-content: center; }
  .visual-placeholder { text-align: center; color: #333; }
  .visual-placeholder h2 { font-size: 3rem; font-weight: 800; letter-spacing: -2px; margin-bottom: 8px; color: #222; }
  .visual-placeholder p { font-size: 0.9rem; color: #222; }

  @media (max-width: 768px) {
    .features-grid { grid-template-columns: 1fr; }
    .feature-box { border-right: none; border-bottom: 1px solid #d0d0d0; }
    .action-row { flex-direction: column; }
    .action-card { justify-content: center; }
  }
</style>
