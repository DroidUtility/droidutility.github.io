---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="page-wrapper">
    
    <!-- Header: Logo Left, Nav Right -->
    <header class="header">
      <a href="/" class="logo">DROIDUTILITY</a>
      <nav class="nav">
        <a href="/features">Features</a>
        <a href="https://github.com/DroidUtility/DroidUtility" target="_blank">GitHub</a>
        <a href="https://github.com/DroidUtility/DroidUtility/releases" class="btn-download">↓ Download</a>
      </nav>
    </header>

    <!-- Hero Section -->
    <main class="hero">
      <h1>The non-root<br>Android utility suite</h1>
      <p class="subtitle">
        Debloat system apps, run interactive terminal commands,<br>
        and optimize your device using Shizuku.
      </p>

      <!-- Terminal / Code Block Mockup -->
      <div class="code-block">
        <div class="code-tabs">
          <span class="active">curl</span>
          <span>wget</span>
          <span>github</span>
        </div>
        <div class="code-content">
          <div>
            <span class="prompt">$</span> git clone https://github.com/DroidUtility/DroidUtility.git
          </div>
          <span class="copy-icon">📋</span>
        </div>
      </div>
    </main>

    <!-- Large Visual Area (The black box at the bottom) -->
    <section class="visual-area">
      <div class="visual-placeholder">
        <h2>DROIDUTILITY</h2>
        <p>[ Terminal + Debloat Manager Interface ]</p>
      </div>
    </section>

  </div>
</Layout>

<style>
  /* The main box wrapper */
  .page-wrapper {
    max-width: 1100px;
    margin: 0 auto;
    border-left: 1px solid #d0d0d0;
    border-right: 1px solid #d0d0d0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* Header */
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 40px;
    border-bottom: 1px solid #d0d0d0;
  }

  .logo {
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -1px;
    color: #0a0a0a;
    text-decoration: none;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 24px;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .nav a {
    color: #666;
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav a:hover {
    color: #0a0a0a;
  }

  .btn-download {
    background: #0a0a0a;
    color: #f2f2f2 !important;
    padding: 8px 16px;
    border: 1px solid #0a0a0a;
    transition: background 0.2s;
  }

  .btn-download:hover {
    background: #333;
  }

  /* Hero Section */
  .hero {
    padding: 80px 40px;
    border-bottom: 1px solid #d0d0d0;
  }

  .hero h1 {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -2px;
    margin-bottom: 24px;
  }

  .subtitle {
    font-size: 1rem;
    color: #555;
    line-height: 1.6;
    margin-bottom: 40px;
    max-width: 600px;
  }

  /* Code Block */
  .code-block {
    max-width: 700px;
    border: 1px solid #d0d0d0;
    background: #eaeaea; /* Slightly darker than background to stand out */
  }

  .code-tabs {
    display: flex;
    border-bottom: 1px solid #d0d0d0;
    padding: 0 16px;
    background: #e0e0e0;
  }

  .code-tabs span {
    padding: 10px 16px;
    font-size: 0.75rem;
    color: #666;
    cursor: pointer;
    border-bottom: 2px solid transparent;
  }

  .code-tabs span.active {
    color: #0a0a0a;
    border-bottom-color: #0a0a0a;
    font-weight: 600;
  }

  .code-content {
    padding: 16px;
    font-size: 0.85rem;
    color: #0a0a0a;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .prompt {
    color: #888;
    margin-right: 12px;
    font-weight: 600;
  }

  .copy-icon {
    cursor: pointer;
    opacity: 0.5;
  }

  .copy-icon:hover {
    opacity: 1;
  }

  /* Visual Area (The dark box) */
  .visual-area {
    flex-grow: 1;
    background: #0a0a0a; /* Stark black contrast */
    padding: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .visual-placeholder {
    text-align: center;
    color: #333;
  }

  .visual-placeholder h2 {
    font-size: 3rem;
    font-weight: 800;
    letter-spacing: -2px;
    margin-bottom: 8px;
    color: #222;
  }

  .visual-placeholder p {
    font-size: 0.9rem;
  }

  /* Mobile responsive */
  @media (max-width: 768px) {
    .header {
      flex-direction: column;
      gap: 16px;
      padding: 20px;
    }
    .nav {
      gap: 16px;
      flex-wrap: wrap;
      justify-content: center;
    }
    .hero {
      padding: 40px 20px;
    }
    .code-content {
      font-size: 0.7rem;
    }
  }
</style>
