---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="page-wrapper">
    
    <!-- Header: Logo Left, Nav Right -->
    <header class="header">
      <a href="/" class="logo">DROIDUTILITY</a>
      <nav class="nav">
        <a href="/features">Features</a>
        <a href="https://github.com/DroidUtility/DroidUtility" target="_blank">GitHub</a>
        <a href="https://github.com/DroidUtility/DroidUtility/releases" class="btn-download">Download</a>
      </nav>
    </header>

    <!-- Hero Section -->
    <main class="hero">
      <h1>The non-root<br>Android utility suite</h1>
      <p class="subtitle">
        Debloat system apps, run interactive terminal commands,<br>
        and optimize your device using Shizuku.
      </p>

      <!-- Action / Download Block (No more terminal clone) -->
      <div class="action-block">
        <div class="action-tabs">
          <span class="active">Download APK</span>
          <span>Source Code</span>
          <span>Read Docs</span>
        </div>
        <div class="action-content">
          <div class="download-info">
            <span class="version">Latest: v1.0.5-beta.6</span>
            <a href="https://github.com/DroidUtility/DroidUtility/releases" class="action-btn">Get it on GitHub</a>
          </div>
        </div>
      </div>
    </main>

    <!-- NEW: Features Grid -->
    <section class="features-grid">
      <div class="feature-box">
        <h3>01 / Debloat</h3>
        <p>Remove system apps safely using the UAD list. No root required.</p>
      </div>
      <div class="feature-box">
        <h3>02 / Terminal</h3>
        <p>A native terminal engine with full ANSI rendering and interactive prompts.</p>
      </div>
      <div class="feature-box">
        <h3>03 / Tweaks</h3>
        <p>Apply system-level performance and battery optimizations with one tap.</p>
      </div>
    </section>

    <!-- Large Visual Area (The dark box) -->
    <section class="visual-area">
      <div class="visual-placeholder">
        <h2>DROIDUTILITY</h2>
        <p>[ App Screenshots Coming Soon ]</p>
      </div>
    </section>

  </div>
</Layout>

<style>
  .page-wrapper {
    max-width: 1100px; margin: 0 auto;
    border-left: 1px solid #d0d0d0; border-right: 1px solid #d0d0d0;
    min-height: 100vh; display: flex; flex-direction: column;
  }

  /* Header */
  .header { display: flex; justify-content: space-between; align-items: center; padding: 24px 40px; border-bottom: 1px solid #d0d0d0; }
  .logo { font-size: 1.4rem; font-weight: 800; letter-spacing: -1px; color: #0a0a0a; text-decoration: none; }
  .nav { display: flex; align-items: center; gap: 24px; font-size: 0.85rem; font-weight: 600; }
  .nav a { color: #666; text-decoration: none; transition: color 0.2s; }
  .nav a:hover { color: #0a0a0a; }
  .btn-download { background: #0a0a0a; color: #f2f2f2 !important; padding: 8px 16px; border: 1px solid #0a0a0a; transition: background 0.2s; }
  .btn-download:hover { background: #333; }

  /* Hero */
  .hero { padding: 80px 40px; border-bottom: 1px solid #d0d0d0; }
  .hero h1 { font-size: clamp(2.5rem, 5vw, 3.5rem); font-weight: 600; line-height: 1.1; letter-spacing: -2px; margin-bottom: 24px; }
  .subtitle { font-size: 1rem; color: #555; line-height: 1.6; margin-bottom: 40px; max-width: 600px; }

  /* Action Block (Replaces Code Block) */
  .action-block { max-width: 700px; border: 1px solid #d0d0d0; background: #eaeaea; }
  .action-tabs { display: flex; border-bottom: 1px solid #d0d0d0; padding: 0 16px; background: #e0e0e0; }
  .action-tabs span { padding: 10px 16px; font-size: 0.75rem; color: #666; cursor: pointer; border-bottom: 2px solid transparent; }
  .action-tabs span.active { color: #0a0a0a; border-bottom-color: #0a0a0a; font-weight: 600; }
  .action-content { padding: 20px 16px; background: #eaeaea; }
  .download-info { display: flex; justify-content: space-between; align-items: center; }
  .version { font-size: 0.85rem; color: #555; font-weight: 600; }
  .action-btn { background: #0a0a0a; color: #fff; text-decoration: none; padding: 10px 20px; font-size: 0.85rem; font-weight: 600; }
  .action-btn:hover { background: #333; }

  /* New Features Grid */
  .features-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; border-bottom: 1px solid #d0d0d0; }
  .feature-box { padding: 40px; border-right: 1px solid #d0d0d0; }
  .feature-box:last-child { border-right: none; }
  .feature-box h3 { font-size: 1rem; font-weight: 800; margin-bottom: 12px; }
  .feature-box p { font-size: 0.85rem; color: #555; line-height: 1.6; }

  /* Visual Area */
  .visual-area { flex-grow: 1; background: #0a0a0a; padding: 40px; display: flex; align-items: center; justify-content: center; }
  .visual-placeholder { text-align: center; color: #333; }
  .visual-placeholder h2 { font-size: 3rem; font-weight: 800; letter-spacing: -2px; margin-bottom: 8px; color: #222; }
  .visual-placeholder p { font-size: 0.9rem; color: #222; }

  @media (max-width: 768px) {
    .features-grid { grid-template-columns: 1fr; }
    .feature-box { border-right: none; border-bottom: 1px solid #d0d0d0; }
    .download-info { flex-direction: column; gap: 16px; align-items: flex-start; }
  }
</style>
