---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="blank-screen">
    <header class="minimal-header">
      <div class="container">
        <span class="logo">DROIDUTILITY_</span>
      </div>
    </header>
  </div>
</Layout>

<style>
  .blank-screen {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .minimal-header {
    padding: 24px 0;
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 24px;
    border-bottom: 1px solid #d0d0d0;
    padding-bottom: 24px;
  }

  .logo {
    font-size: 2rem;
    font-weight: 1000;
    letter-spacing: -0.5px;
  }
</style>
