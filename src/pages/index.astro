---
import Layout from '../layouts/Layout.astro';
---

<header class="minimal-header">
  <div class="container header-content">
    <a href="/" class="logo">DROIDUTILITY_</a>
    <nav class="nav">
      <a href="/" class="active">Home</a>
      <a href="/features">Features</a>
    </nav>
  </div>
</header>

<style>
  .blank-screen {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .minimal-header {
    padding: 24px 0;
  }

  .container {
    max-width: 1050px;
    margin: 0 auto;
    padding: 0 24px;
    border-bottom: 1px solid #d0d0d0;
    padding-bottom: 24px;
  }

  .logo {
    font-size: 2rem;
    font-weight: 650;
    letter-spacing: -0.5px;
  }
</style>
