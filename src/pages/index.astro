---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <header class="header">
    <div class="container">
      <div class="logo">
        <img src="https://api.iconify.design/mdi:android.svg?color=%2390caf9" alt="Logo" width="40" height="40" />
        <span>DroidUtility</span>
      </div>
      <nav class="nav">
        <a href="#features">Features</a>
        <a href="https://github.com/DroidUtility/DroidUtility" target="_blank">GitHub</a>
      </nav>
    </div>
  </header>

  <section class="hero">
    <div class="container">
      <div class="badge">No root required • Powered by Shizuku</div>
      <h1><span>DroidUtility</span></h1>
      <p>A powerful Android utility suite for debloating, shell command execution, and device management.</p>
    </div>
  </section>

  <section class="features" id="features">
    <div class="container grid">
      <div class="card">
        <h3>Shell Terminal</h3>
        <p>Run shell commands through Shizuku with real-time output.</p>
      </div>
      <div class="card">
        <h3>Debloat Manager</h3>
        <p>Browse installed apps and uninstall or disable with one tap.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }
  .header { padding: 18px 0; border-bottom: 1px solid #2a2a2a; background: #121212; }
  .header .container { display: flex; justify-content: space-between; align-items: center; }
  .logo { display: flex; align-items: center; gap: 12px; color: #fff; font-weight: 800; font-size: 1.25rem; }
  .nav { display: flex; gap: 18px; }
  .nav a { font-weight: 500; color: #aaa; }
  .nav a:hover { color: #90caf9; text-decoration: none; }
  
  .hero { padding: 100px 0 70px; text-align: center; background: linear-gradient(180deg, #1a1a3a 0%, #0d0d0d 100%); }
  .hero .badge { display: inline-block; color: #90caf9; padding: 6px 16px; font-size: 0.82rem; font-weight: 700; margin-bottom: 22px; border: 1px solid #90caf9; }
  .hero h1 { font-size: 3.5rem; font-weight: 800; margin-bottom: 16px; }
  .hero h1 span { color: #90caf9; }
  .hero p { font-size: 1.12rem; color: #b0b0b0; max-width: 720px; margin: 0 auto; }

  .features { padding: 82px 0; background: #121212; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 24px; }
  .card { background: #1e1e1e; padding: 26px; border: 1px solid #2a2a2a; }
  .card h3 { color: #fff; margin-bottom: 8px; }
  .card p { color: #b0b0b0; }
</style>
